# LiteLLM proxy auth key for Claude Code -> LiteLLM requests.
# Keep this distinct from any provider API key. Claude Code sends it via
# ANTHROPIC_CUSTOM_HEADERS as x-litellm-api-key.
LITELLM_MASTER_KEY=sk-litellm-local

# Anthropic API key (only needed if you are using direct Anthropic API auth
# instead of Claude Code Max/Pro passthrough)
# ANTHROPIC_API_KEY=sk-ant-...

# Observer LLM config (calls provider directly, bypassing the proxy)
# OBSERVER_MODEL=claude-sonnet-4-20250514
# OBSERVER_API_KEY=sk-ant-...
# OBSERVER_BASE_URL=https://api.anthropic.com/v1
OBSERVER_MODEL=gpt-5.4
OBSERVER_API_KEY=sk-proj-...
OBSERVER_BASE_URL=https://api.openai.com/v1

# Decision OS global workspace (fallback when no project .decision-os/ is found)
DECISION_OS_PATH=/Users/YOU/.decision-os

# Path to Decision OS repo (for Python callback import)
DECISION_OS_REPO=/Users/YOU/Documents/DecisionOS
